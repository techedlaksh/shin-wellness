---
import ScopeStatement from "../components/ScopeStatement.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pillars } from "../data/site";
---

<BaseLayout
  title="A quieter way back to yourself"
  description="Shin Wellness brings together Alignment Yoga, meditation, embodied awareness, and psychologically informed reflection in a warm, unhurried practice."
>
  <section class="home-hero home-grid" aria-labelledby="home-title">
    <div class="home-hero-copy">
      <p class="eyebrow">Embodied wellness with Saebyuk Shin</p>
      <h1 id="home-title">A quieter way back to yourself.</h1>
      <p class="hero-lede">
        Movement, meditation, and reflective inner work for people who want to feel more present
        in their body, their choices, and their everyday life.
      </p>
      <div class="button-row">
        <a class="button" href="/contact">Begin a conversation <span aria-hidden="true">↗</span></a>
        <a class="button button-secondary" href="/practice">Explore the practice</a>
      </div>
      <ul class="hero-practice-list" aria-label="Shin Wellness practice themes">
        <li>Movement</li>
        <li>Stillness</li>
        <li>Reflection</li>
        <li>Connection</li>
      </ul>
    </div>

    <div
      class="hero-art"
      role="img"
      aria-label="Abstract dawn forms suggesting movement, stillness, reflection, and connection"
    >
      <div class="orbit orbit-outer" aria-hidden="true"></div>
      <div class="orbit orbit-middle" aria-hidden="true"></div>
      <div class="orbit orbit-inner" aria-hidden="true"></div>
      <div class="orbit-sun" aria-hidden="true"></div>
      <div class="orbit-moon" aria-hidden="true"></div>
      <div class="orbit-dot orbit-dot-one" aria-hidden="true"></div>
      <div class="orbit-dot orbit-dot-two" aria-hidden="true"></div>
      <span class="art-caption art-caption-top" aria-hidden="true">arrive</span>
      <span class="art-caption art-caption-bottom" aria-hidden="true">return</span>
    </div>
  </section>

  <section class="home-manifesto home-grid" aria-labelledby="manifesto-title">
    <p class="section-index" aria-hidden="true">01</p>
    <div class="manifesto-heading">
      <p class="eyebrow">Another way to listen</p>
      <h2 id="manifesto-title">You do not need to think your way through everything.</h2>
    </div>
    <div class="manifesto-copy">
      <p class="statement">
        Sometimes the mind has been working for so long that thinking harder no longer helps.
      </p>
      <p>
        Shin Wellness offers another way in: through movement, breath, stillness, and guided
        reflection. You do not need to arrive with an explanation. You can begin with an
        experience.
      </p>
    </div>
  </section>

  <section class="home-practice" aria-labelledby="practice-title">
    <div class="section-heading home-grid">
      <p class="section-index" aria-hidden="true">02</p>
      <div>
        <p class="eyebrow">The practice</p>
        <h2 id="practice-title">Four ways of returning to the whole person.</h2>
      </div>
      <p class="section-intro">
        Each gathering moves at a human pace. Nothing to perfect, prove, or perform.
      </p>
    </div>
    <div class="practice-cards">
      {
        pillars.map((pillar, index) => (
          <article class="practice-card">
            <span class="practice-number" aria-hidden="true">0{index + 1}</span>
            <div class={`practice-symbol practice-symbol-${index + 1}`} aria-hidden="true"></div>
            <h3>{pillar.title}</h3>
            <p>{pillar.text}</p>
          </article>
        ))
      }
    </div>
    <a class="text-link practice-link" href="/practice">See how the practice comes together</a>
  </section>

  <section class="gathering-story home-grid" aria-labelledby="gathering-title">
    <p class="section-index" aria-hidden="true">03</p>
    <div class="gathering-visual" aria-hidden="true">
      <div class="gathering-field"></div>
      <div class="gathering-circle gathering-circle-one"></div>
      <div class="gathering-circle gathering-circle-two"></div>
      <div class="gathering-circle gathering-circle-three"></div>
      <p>move<br />breathe<br />notice<br />rest</p>
    </div>
    <div class="gathering-copy">
      <p class="eyebrow">Gather with Shin</p>
      <h2 id="gathering-title">A small room can make space for something spacious.</h2>
      <p>
        Gatherings are intimate by design: a thoughtful setting for gentle movement, quiet
        attention, and optional reflection. Participate from where you are, without pressure to
        share or disclose.
      </p>
      <a class="text-link" href="/gatherings">Discover current gatherings</a>
    </div>
  </section>

  <section class="guide-section home-grid" aria-labelledby="guide-title">
    <p class="section-index" aria-hidden="true">04</p>
    <div class="guide-heading">
      <p class="eyebrow">Guided by Saebyuk</p>
      <h2 id="guide-title">Professional learning, held with a human pace.</h2>
    </div>
    <div class="guide-note">
      <p class="guide-initial" aria-hidden="true">S</p>
      <p>
        Saebyuk Shin brings together Alignment Yoga, meditation, embodied awareness, and
        psychologically informed inner work. Her approach is warm, curious, and grounded in the
        understanding that different people need different ways of returning to themselves.
      </p>
      <a class="text-link" href="/saebyuk">Meet Saebyuk</a>
    </div>
  </section>

  <section class="home-scope home-grid" aria-label="Scope of practice information">
    <p class="section-index" aria-hidden="true">05</p>
    <div class="scope-kicker">
      <p class="eyebrow">Clear care</p>
      <p>Wellness and reflective practice, with honest boundaries.</p>
    </div>
    <ScopeStatement />
  </section>

  <section class="home-invitation" aria-labelledby="invitation-title">
    <div class="invitation-orbit" aria-hidden="true"></div>
    <p class="eyebrow">Your first step can be simple</p>
    <h2 id="invitation-title">Something brought you here.<br />You can begin there.</h2>
    <p>
      You do not need to know exactly which practice is right for you. Start with a conversation,
      and Saebyuk will share what is currently available.
    </p>
    <a class="button button-light" href="/contact">Begin a conversation <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
