---
import ContactPanel from "../components/ContactPanel.astro";
import PillarDiagram from "../components/PillarDiagram.astro";
import ScopeStatement from "../components/ScopeStatement.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, whatsappUrl } from "../data/site";
---

<BaseLayout title="A space to move, reflect, and reconnect">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Shin Wellness</p>
      <h1>A space to move, reflect, and reconnect with yourself.</h1>
      <p class="hero-lede">
        Alignment Yoga, meditation, embodied awareness, and psychologically informed inner work
        guided by Saebyuk Shin.
      </p>
      <div class="button-row">
        <a class="button" href={whatsappUrl("home")} target="_blank" rel="noreferrer">
          Contact Saebyuk
        </a>
        <a class="button button-secondary" href="/practice">Explore the practice</a>
      </div>
      <p class="small-note">
        Private gatherings, evolving programs, and practices you can carry into everyday life.
      </p>
    </div>
    <div class="hero-media">
      <img src={site.heroImage} alt="A calm visual representing an intimate Shin Wellness gathering" />
    </div>
  </section>

  <section class="section-inner split-section">
    <div>
      <p class="eyebrow">Another way to listen</p>
      <h2>Sometimes the mind has been working for so long that thinking harder no longer helps.</h2>
    </div>
    <div>
      <p>
        Shin Wellness offers another way to listen through movement, stillness, awareness, and
        guided reflection.
      </p>
      <ul class="check-list">
        <li>You may feel disconnected from your body.</li>
        <li>You may be moving through a period of uncertainty or change.</li>
        <li>You may want to understand yourself without turning everything into a problem to solve.</li>
        <li>You may simply need a space where nothing is expected from you.</li>
      </ul>
      <p class="strong-line">You do not need to arrive with an explanation. You can begin with an experience.</p>
    </div>
  </section>

  <section class="section-band">
    <div class="section-inner">
      <p class="eyebrow">The practice</p>
      <h2>Movement for the body. Space for the mind. A practice for the whole person.</h2>
      <PillarDiagram />
    </div>
  </section>

  <section class="section-inner split-section">
    <div>
      <p class="eyebrow">Guided by Saebyuk</p>
      <h2>An embodied wellness practice informed by yoga, meditation, psychotherapy, play therapy, and guided inner work.</h2>
    </div>
    <div>
      <p>
        Shin Wellness brings together Alignment Yoga, meditation, embodied awareness, and
        psychologically informed inner work through intimate gatherings and evolving digital
        practices.
      </p>
      <a class="text-link" href="/saebyuk">Meet Saebyuk</a>
    </div>
  </section>

  <section class="section-inner">
    <ScopeStatement />
  </section>

  <ContactPanel messageKey="home" />

  <section class="final-invitation">
    <div class="section-inner">
      <h2>Something brought you here. You can begin there.</h2>
      <p>
        Whether you are interested in movement, meditation, inner reflection, or simply finding a
        more grounded relationship with yourself, Saebyuk would be glad to hear from you.
      </p>
      <a class="button" href={whatsappUrl("home")} target="_blank" rel="noreferrer">
        Contact Saebyuk
      </a>
      <p class="small-note">Opens a private WhatsApp conversation.</p>
    </div>
  </section>
</BaseLayout>
